# VoxAssist Environment Configuration

# OpenAI API (LLM & Embeddings & STT)
OPENAI_API_KEY=your_openai_api_key_here

# Rime TTS API Key & Voice Selection
RIME_API_KEY=your_rime_api_key_here
RIME_VOICE_ID=marcus
RIME_SPEAKER_SPEED=1.0

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# MongoDB Database
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=voxassist

# Redis Cache & PubSub
REDIS_URL=redis://localhost:6379/0

# Server Port
PORT=8000
HOST=0.0.0.0
